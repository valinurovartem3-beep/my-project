# Токен бота от @BotFather
TELEGRAM_TOKEN=123456789:AAAA...

# Бесплатный токен с https://app.pandascore.co (раздел Dashboard)
PANDASCORE_TOKEN=your_pandascore_token

# Контакт для Liquipedia (ваша почта или ник в Telegram) — по их правилам он обязателен.
# Без него прогноз по картам CS2 отключается.
LIQUIPEDIA_CONTACT=you@example.com

# Необязательные настройки
# Уровни турниров для статистики карт (S, A, B). B добавит больше команд, но первая загрузка будет дольше
LIQUIPEDIA_TIERS=S,A
# За сколько дней учитывать сыгранные карты
MAP_HISTORY_DAYS=180
TIMEZONE=Europe/Moscow
DIGEST_HOUR=10
# Сколько страниц истории (по 100 матчей) загружать для обучения рейтинга
HISTORY_PAGES=10
